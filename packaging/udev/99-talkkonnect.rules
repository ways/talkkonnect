# udev rules for talkkonnect hardware access
# Installed to /etc/udev/rules.d/99-talkkonnect.rules
# Reload with: sudo udevadm control --reload-rules && sudo udevadm trigger

# ── GPIO ─────────────────────────────────────────────────────────────────────
# Raspberry Pi GPIO memory device (RPi OS / gpiomem driver)
SUBSYSTEM=="bcm2835-gpiomem", GROUP="gpio", MODE="0660"

# Generic GPIO character device (Linux 5.x+ gpiochip)
SUBSYSTEM=="gpio", GROUP="gpio", MODE="0660"

# ── I2C ──────────────────────────────────────────────────────────────────────
# I2C bus devices (LCD, OLED, MCP23017 GPIO expander, etc.)
SUBSYSTEM=="i2c-dev", GROUP="i2c", MODE="0660"
KERNEL=="i2c-[0-9]*", GROUP="i2c", MODE="0660"

# ── SPI ──────────────────────────────────────────────────────────────────────
# SPI devices (MAX7219 LED matrix, etc.)
SUBSYSTEM=="spidev", GROUP="spi", MODE="0660"
KERNEL=="spidev[0-9]*.[0-9]*", GROUP="spi", MODE="0660"

# ── Serial / UART ─────────────────────────────────────────────────────────────
# USB serial adapters (GPS dongles, SA818 radio module)
KERNEL=="ttyUSB[0-9]*", GROUP="dialout", MODE="0660"
# RPi hardware UART (GPS, radio)
KERNEL=="ttyAMA[0-9]*", GROUP="dialout", MODE="0660"
KERNEL=="ttyS[0-9]*",   GROUP="dialout", MODE="0660"
